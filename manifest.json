{
  "name": "Scriptrail",
  "description": "Track and analyze writing activity on Google Docs — sessions, copy-paste detection, edit replay, and more.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://docs.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["utils.js", "content.js", "infobar.js"],
      "matches": ["https://docs.google.com/document/*"],
      "all_frames": false,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "report.html",
        "report.js",
        "report.css",
        "theme.css",
        "docsStyle.css",
        "libs/chart.min.js",
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
